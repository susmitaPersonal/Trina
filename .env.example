# apps/server — copy to apps/server/.env (never commit real values)
PORT=3000
# Leave DATABASE_URL empty for zero-setup embedded PGlite (./.data/pglite)
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Self-hosted open-weight model (Ollama / llama.cpp server / vLLM). Never a proprietary cloud LLM.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
# Optional offline map tiles (PMTiles URL)
TILES_URL=
PUBLIC_BASE_URL=http://localhost:3000

# apps/mobile — Expo public env (baked into the app)
# Android emulator reaches your laptop at 10.0.2.2; a real phone needs your LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
