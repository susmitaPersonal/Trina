{
  "name": "@trina/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && jest",
    "test:ui": "jest",
    "android:emulator": "emulator -list-avds && emulator -avd $(emulator -list-avds | head -1)",
    "android:reverse": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8081 tcp:8081",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease && echo APK: android/app/build/outputs/apk/release/app-release.apk",
    "build:apk:cloud": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@trina/ai": "workspace:*",
    "@trina/contracts": "workspace:*",
    "@trina/engine": "workspace:*",
    "expo": "~57.0.27",
    "expo-background-task": "~57.0.21",
    "expo-battery": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "qrcode-generator": "^1.5.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
